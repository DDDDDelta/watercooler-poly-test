# systemd unit for the server. Install once (see deploy/README.md):
#   sudo cp deploy/watercooler.service /etc/systemd/system/watercooler.service
#   sudo systemctl daemon-reload && sudo systemctl enable watercooler
# Adjust User/Group, paths and the node binary to match your server.

[Unit]
Description=Watercooler prediction market
After=network.target

[Service]
Type=simple
# The account GitHub Actions deploys as; it owns /opt/watercooler.
User=deploy
Group=deploy
WorkingDirectory=/opt/watercooler/current
Environment=NODE_ENV=production
# Only reachable through nginx, never directly from the internet.
Environment=HOST=127.0.0.1
Environment=PORT=3000
# Served at https://<domain>/watercooler/. nginx strips the prefix; the app uses it for the cookie path.
Environment=BASE_PATH=/watercooler
Environment=DATABASE_PATH=/opt/watercooler/shared/data/watercooler.db
# Optional overrides such as INVITE_CODE or PRIVATE_MODE (see .env.example).
EnvironmentFile=-/opt/watercooler/shared/.env
# Must be an absolute path to Node.js >= 20.19 (check with `command -v node`).
ExecStart=/usr/bin/node apps/server/dist/index.js
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
