# systemd unit for the server. Install once (see deploy/README.md):
#   sudo cp deploy/watercooler.service /etc/systemd/system/watercooler.service
#   sudo systemctl daemon-reload && sudo systemctl enable watercooler
# Set User= to the account GitHub Actions deploys as and check the node path in ExecStart.

[Unit]
Description=Watercooler prediction market
After=network.target

[Service]
Type=simple
# The SSH account GitHub Actions deploys as (DEPLOY_USER). The app lives in its ~/watercooler.
User=deploy
# "~" is the home directory of User=; the relative paths below are relative to it.
WorkingDirectory=~
Environment=NODE_ENV=production
# Only reachable through nginx, never directly from the internet.
Environment=HOST=127.0.0.1
Environment=PORT=3000
# Served at https://<domain>/watercooler/. nginx strips the prefix; the app uses it for the cookie path.
Environment=BASE_PATH=/watercooler
Environment=DATABASE_PATH=watercooler/shared/data/watercooler.db
# Optional settings (INVITE_CODE, PRIVATE_MODE, ...) go in ~/watercooler/shared/.env. Each deploy links
# it into the release and the app loads it at startup; values set above take precedence.
# Node must be an absolute path to Node.js >= 20.19 (check with `command -v node`).
ExecStart=/usr/bin/node watercooler/current/apps/server/dist/index.js
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
