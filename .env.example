# 复制为 .env 后按需修改（都是可选项）

# 服务端口
PORT=3000
# SQLite 数据库文件路径（默认 ./data/watercooler.db）
# DATABASE_PATH=./data/watercooler.db

# 设置后，注册需要填写邀请码（推荐在公司内网之外部署时开启）
# INVITE_CODE=change-me

# 新用户注册赠送的水滴
STARTING_BALANCE=1000
# 每日签到奖励，0 表示关闭
DAILY_BONUS=100

# 这些用户名注册后自动成为管理员（逗号分隔）。第一个注册的用户总是管理员。
# ADMIN_USERNAMES=alice,bob

# 私有模式：未登录用户看不到任何内容（默认关闭，未登录也能浏览市场，类似 Polymarket）
# PRIVATE_MODE=true

# 普通用户能否创建市场（false 则只有管理员可以）
ALLOW_USER_MARKETS=true

# “每日”签到按哪个时区算
APP_TIMEZONE=Asia/Shanghai
